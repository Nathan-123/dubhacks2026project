# Copy to .env (never commit .env) and fill in.

# OpenRouter key from https://openrouter.ai/keys. Only FREE models are called: the server
# checks each model's price against OpenRouter's model list and refuses anything not $0.
OPENROUTER_API_KEY=

# Model for confidence scores. "openrouter/free" routes to whichever free model is available.
# Any model ID ending in ":free" also works, e.g. google/gemma-4-31b-it:free
CONFIDENCE_MODEL=openrouter/free

# LLM tier for reading pages the on-device extractor can't parse:
#   openrouter (default when OPENROUTER_API_KEY is set)  |  ollama (free, fully local)
# FIT_LLM_PROVIDER=openrouter
# EXTRACT_MODEL=openrouter/free
# FIT_LLM_MODEL=qwen2.5:3b          # Ollama model, when FIT_LLM_PROVIDER=ollama

# Leave unset. Setting it to 1 allows paid OpenRouter models.
# FIT_ALLOW_PAID_MODELS=
